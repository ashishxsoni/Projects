<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('./partials/head', {titlename: 'Blog Page'}) %>
  </head>
  <body>
    <%- include('./partials/nav') %>

    <!-- Blog Post Header Part -->
    <div class="container mt-4">
      <h1><%= blog.title %></h1>
      <img src="<%= blog.coverImageURL || '/default-cover.jpg' %>" width="700px" alt="Blog Cover Image" />
      <pre class="mt-3"><%= blog.blogbody %></pre>
    </div>
    
    <!-- Blog Creator Information -->
    <div class="container mt-4">
      <img src="<%= blog.createdBy.profileImageURL || '/default-avatar.png' %>" width="50px" alt="Creator's Profile Image" />
      <strong><%= blog.createdBy.fullName || 'Unknown Author' %></strong>
    </div>

    <!-- Comment Section -->
    <div class="container mt-3">
      <h1>Comments (<%= comments?.length || 0 %>)</h1>
      
      <!-- Add New Comment Form -->
      <form action="/blog/comment/<%= blog._id %>" method="post">
        <div class="mb-3">
          <textarea
            name="content"
            class="form-control"
            placeholder="Enter your comment"
            required
          ></textarea>
          <button class="btn btn-sm btn-primary mt-2" type="submit">Add Comment</button>
        </div>
      </form>
     
      <!-- Showing All Comments -->
      <% if (comments && comments.length > 0) { %>
        <div class="mt-4">
          <% comments.forEach(comment => { %>
          <div class="comment mt-3">
            <img
              src="<%= comment.createdBy.profileImage || '/default-avatar.png' %>"
              width="50px"
              alt="User avatar"
            />
            <strong><%= comment.createdBy.fullname || 'Anonymous' %></strong>
            <p><%- comment.content %></p>
          </div>
          <% }) %>
        </div>
      <% } else { %>
        <p class="text-center">No comments available.</p>
      <% } %>
    </div>
  </body>
</html>
