<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login</title>
  <link rel="stylesheet" href="/css/signupstyle.css"> <!-- Link to the CSS file -->
</head><link rel="icon" href="https://i.pinimg.com/736x/fe/92/35/fe9235dccffe990f556b93c3761ca8b4.jpg" type="image/x-icon">
<body>
  <div class="form-container">
    <h1>Login</h1>
    <form action="/user/login" method="POST">
      <div class="form-group">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" required>
      </div>

      <div class="form-group">
        <label for="password">Password</label>
        <input type="password" id="password" name="password" required>
      </div>

      <div class="form-group">
        <button type="submit">Login</button>
      </div>
      
      <p>Don't have an account? <a href="/user/signup">Sign Up here</a></p>
    </form>
  </div>
</body>
</html>
